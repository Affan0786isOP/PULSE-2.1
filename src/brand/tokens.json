{
  "$schema": "https://json.schemastore.org/design-tokens",
  "name": "PULSE Identity System Tokens",
  "version": "2.1.0",
  "color": {
    "ground": {
      "obsidian": {
        "value": "#08080A",
        "description": "Global viewport ground, deep non-glare obsidian matte"
      },
      "graphite": {
        "value": "#12171F",
        "description": "Card surface, laboratory instrument panel"
      },
      "surfaceElevated": {
        "value": "#1A212B",
        "description": "Tactile interactive surface, active states, modals"
      }
    },
    "border": {
      "hairline": {
        "value": "rgba(255, 255, 255, 0.08)",
        "description": "Precision 1px card boundary"
      },
      "subtle": {
        "value": "#1F2732",
        "description": "Grid reticle dividing lines"
      },
      "active": {
        "value": "#2A3442",
        "description": "Focused or active control perimeter"
      }
    },
    "telemetry": {
      "cyan": {
        "value": "#00F0FF",
        "description": "Primary stimulus reticle, active response window, optical indicator"
      },
      "cyanSubtle": {
        "value": "rgba(0, 240, 255, 0.12)",
        "description": "Telemetry badge background and indicator glow"
      },
      "provenanceGreen": {
        "value": "#10B981",
        "description": "Cryptographic HMAC-SHA256 attestation verified, valid trial"
      },
      "provenanceGreenSubtle": {
        "value": "rgba(16, 185, 129, 0.15)",
        "description": "Cryptographic verified tag container fill"
      },
      "standbyAmber": {
        "value": "#F59E0B",
        "description": "Stimulus armed, awaiting randomized trigger window"
      },
      "faultRed": {
        "value": "#EF4444",
        "description": "Premature click, false start violation (<80ms physiological floor)"
      }
    },
    "typography": {
      "titanium": {
        "value": "#F8FAFC",
        "description": "Primary high-contrast readout, display headlines, metrics"
      },
      "slateMuted": {
        "value": "#7E808C",
        "description": "Secondary telemetry labels, units (ms), timestamps"
      },
      "slateDisabled": {
        "value": "#4B5563",
        "description": "De-emphasized or disabled telemetry channels"
      }
    }
  },
  "typography": {
    "fontFamily": {
      "sans": "Inter, system-ui, -apple-system, sans-serif",
      "display": "Space Grotesk, -apple-system, sans-serif",
      "mono": "JetBrains Mono, Menlo, Courier New, monospace"
    },
    "scale": {
      "telemetryMicro": { "fontSize": "11px", "letterSpacing": "0.05em", "fontFamily": "mono" },
      "caption": { "fontSize": "12px", "lineHeight": "16px" },
      "body": { "fontSize": "14px", "lineHeight": "20px" },
      "bodyLarge": { "fontSize": "16px", "lineHeight": "24px" },
      "metricSecondary": { "fontSize": "20px", "lineHeight": "28px", "fontFamily": "mono" },
      "metricPrimary": { "fontSize": "32px", "lineHeight": "40px", "fontFamily": "mono" },
      "displayHeadline": { "fontSize": "48px", "lineHeight": "52px", "fontFamily": "display", "letterSpacing": "-0.02em" }
    }
  },
  "geometry": {
    "reticle": {
      "strokeWidthRatio": 0.08,
      "bracketLengthRatio": 0.32,
      "centerDotRadiusRatio": 0.065,
      "aspectRatio": "1:1"
    },
    "borderRadius": {
      "card": "8px",
      "badge": "4px",
      "squircle": "22.5%"
    }
  }
}
