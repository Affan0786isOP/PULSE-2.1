{
  "name": "PULSE Evaluator - Precision Reaction & Memory Benchmark",
  "short_name": "PULSE",
  "description": "Precision User Latency & Stimulus Evaluator. Calibrated visual reaction time, spatial directional discrimination, color recognition, and working memory tests.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#0B0D10",
