rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all documents and subcollections not explicitly permitted
    match /{document=**} {
      allow read, write: if false;
    }

    // Collection: assessmentSessions (Legacy - closed)
    match /assessmentSessions/{docId} {
      allow read, write: if false;
    }

    // Collection: assessmentTrials (Granular trial records scoped strictly to participant)
    match /assessmentTrials/{docId} {
      allow read: if request.auth != null && resource.data.participantId == request.auth.uid;
      allow write: if false; // Server authoritative
    }

    // Collection: assessmentResults (Participant results scoped strictly to participant)
    match /assessmentResults/{docId} {
      allow read: if request.auth != null && resource.data.participantId == request.auth.uid;
      allow write: if false; // Server authoritative
    }

    // Collection: publicDataset (Anonymized observations for research dataset)
    match /publicDataset/{docId} {
      allow read: if request.auth != null;
      allow write: if false; // Server authoritative
    }

    // Collection: trialObservations (Granular trial measurements scoped strictly to participant)
    match /trialObservations/{docId} {
      allow read: if request.auth != null && resource.data.participantId == request.auth.uid;
      allow write: if false; // Server authoritative
    }

    // Collection: experimentSessions (Session tokens and HMAC secrets - server only)
    match /experimentSessions/{docId} {
      allow read, write: if false; // Server authoritative only via Admin SDK
    }

    // Collection: adminAuditLogs (Immutable ledger managed authoritatively by server)
    match /adminAuditLogs/{docId} {
      allow read, write: if false; // Server authoritative only via verified admin token
    }

    // Leaderboard results are served through the backend API, which returns only
    // public fields. Firestore security rules cannot hide individual fields inside
    // a readable document, so clients must not read these documents directly.
    match /leaderboardResults/{docId} {
      allow read, write: if false; // Server Admin SDK only
    }

    // Participant ownership, idempotency, and provenance details are server-only.
    match /leaderboardPrivateMeta/{docId} {
      allow read, write: if false;
    }

    // Per-owner transaction guards contain pseudonymous owner-index state.
    match /leaderboardOwnerIndex/{docId} {
      allow read, write: if false;
    }
  }
}
