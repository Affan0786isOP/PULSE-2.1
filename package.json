{
  "name": "pulse",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "npm@10.9.7",
  "scripts": {
    "test": "npm run audit:typography && vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:prod": "node -e \"process.env.E2E_PROD='1'; const { execSync } = require('child_process'); execSync('npx playwright test tests/e2e/seo-offline-suite.spec.ts', { stdio: 'inherit', env: process.env });\"",
    "dev": "tsx server.ts",
    "build": "npm run audit:typography && vite build && vite build --config mobile/vite.config.ts && node scripts/generate-seo-pages.mjs && node scripts/audit-seo-crawl.mjs && esbuild server.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server.js",
    "start": "node dist/server.js",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "check": "npm run audit:typography && tsc --noEmit && cd mobile && tsc --noEmit",
    "migrate:leaderboard-privacy": "tsx scripts/migrateLeaderboardPrivacyAndAudit.ts",
    "migrate:leaderboard-best-per-owner": "tsx scripts/dedupeLeaderboardBestPerOwner.ts",
    "migrate:leaderboard-accuracy": "tsx scripts/backfillLeaderboardAccuracy.ts",
    "dev:mobile": "vite --config mobile/vite.config.ts --port=3000 --host=0.0.0.0",
    "build:mobile": "vite build --config mobile/vite.config.ts && node scripts/generate-seo-pages.mjs",
    "generate-icons": "node scripts/generate-icons.js",
    "seo:audit": "node scripts/audit-seo-crawl.mjs",
    "audit:typography": "node scripts/audit-typography.mjs",
    "dataset:reconcile-summary": "tsx scripts/reconcileDatasetSummary.ts"
  },
  "dependencies": {
    "@sentry/react": "^11.10.0",
    "@tailwindcss/vite": "^4.3.5",
    "@vercel/analytics": "^2.0.1",
    "@vitejs/plugin-react": "^6.2.1",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "firebase": "^13.2.0",
    "firebase-admin": "^14.3.0",
    "lucide-react": "^1.66.0",
    "motion": "^14.9.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-is": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react-is": "^19.2.0",
    "esbuild": "^0.28.2",
    "jpeg-js": "^0.4.4",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=24.12.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "protobufjs@7.6.6": true,
    "@firebase/util@1.15.3": true
  },
  "overrides": {
    "jwks-rsa": {
      "jose": "5.10.0"
    },
    "@grpc/grpc-js": "^1.14.5",
    "uuid": "^11.1.1"
  }
}
