{
  "name": "pulse",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "npm@10.9.7",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "dev": "tsx server.ts",
    "build": "vite build && vite build --config mobile/vite.config.ts && node scripts/generate-seo-pages.mjs && esbuild server.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server.js",
    "start": "node dist/server.js",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "check": "tsc --noEmit && cd mobile && tsc --noEmit",
    "migrate:leaderboard-privacy": "tsx scripts/migrateLeaderboardPrivacyAndAudit.ts",
    "migrate:leaderboard-best-per-owner": "tsx scripts/dedupeLeaderboardBestPerOwner.ts",
    "migrate:leaderboard-accuracy": "tsx scripts/backfillLeaderboardAccuracy.ts",
    "dev:mobile": "vite --config mobile/vite.config.ts --port=3000 --host=0.0.0.0",
    "build:mobile": "vite build --config mobile/vite.config.ts",
    "generate-icons": "node scripts/generate-icons.js"
  },
  "dependencies": {
    "@sentry/react": "^11.7.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vercel/analytics": "^2.0.1",
    "@vitejs/plugin-react": "^5.0.4",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.1",
    "firebase": "^12.17.1",
    "firebase-admin": "^14.3.0",
    "lucide-react": "^1.52.0",
    "motion": "^14.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-is": "^19.3.1",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/express": "^4.17.21",
    "@types/node": "^26.6.4",
    "@types/react-is": "^19.2.0",
    "esbuild": "^0.28.2",
    "jpeg-js": "^0.4.4",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": "^22.12.0 || >=23.0.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "protobufjs@7.6.6": true,
    "@firebase/util@1.15.3": true
  },
  "overrides": {
    "jwks-rsa": {
      "jose": "5.10.0"
    }
  }
}
